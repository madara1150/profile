generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Project {
  id            String  @id
  title         String?
  desc          String?
  tags          String?
  images        String?
  location      String?
  time          String?
  reference_url String?
  files         String?

  @@map("projects")
}

model User {
  id         String  @id
  username   String  @unique(map: "sqlite_autoindex_users_2")
  password   String
  email      String  @unique(map: "sqlite_autoindex_users_3")
  sex        String?
  first_name String?
  last_name      String?
  avatar         String?
  email_verified Boolean @default(false)
  verify_token   String?

  @@map("users")
}
